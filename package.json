{
  "name": "looksee",
  "version": "0.1.0",
  "description": "Self-hosted visual regression testing for Storybook. Frictionless adoption: three commands and you're done.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Luis Grande",
    "url": "https://github.com/luisgrandegg"
  },
  "homepage": "https://github.com/luisgrandegg/looksee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luisgrandegg/looksee.git"
  },
  "bugs": {
    "url": "https://github.com/luisgrandegg/looksee/issues"
  },
  "keywords": [
    "visual-regression",
    "storybook",
    "lost-pixel",
    "playwright",
    "ci",
    "github-actions",
    "screenshot",
    "diff",
    "self-hosted"
  ],
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "looksee": "bin/looksee.js"
  },
  "main": "dist/index.js",
  "files": [
    "bin",
    "dist",
    "src/templates",
    "action.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ext .ts,.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "node -e \"try{require('child_process').execSync('git config core.hooksPath githooks',{stdio:'ignore'})}catch(_){}\"",
    "prepublishOnly": "npm run build && npm run typecheck && npm test"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "picocolors": "^1.1.1",
    "prompts": "^2.4.2",
    "sort-package-json": "^2.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/prompts": "^2.4.9",
    "@typescript-eslint/eslint-plugin": "^8.13.0",
    "@typescript-eslint/parser": "^8.13.0",
    "@vitest/coverage-v8": "^2.1.4",
    "eslint": "^8.57.1",
    "tsup": "^8.3.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
